# Your game's domain: players are addressed handle@SGIP_PLATFORM_ID.
SGIP_PLATFORM_ID=yourgame.example
SGIP_PLATFORM_NAME="Your Game"
SGIP_PLATFORM_ICON="🎮"
# Where the app is reachable over HTTPS: the hub fetches https://SGIP_PLATFORM_ID/.well-known/sgip.json.
APP_URL=https://yourgame.example

# From `npm run keys`. Never commit the secret.
SGIP_PUBLIC_KEY=
SGIP_SECRET_KEY=

# The hub. Its public key is looked up at <hub>/.well-known/sgip-hub.json.
SGIP_HUB_URL=
