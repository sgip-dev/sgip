{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgip.dev/schemas/v0.1/vocabulary.json",
  "title": "Vocabulary domain",
  "description": "One domain of the SGIP vocabulary registry (spec/vocabulary). Generated wire definitions in common.json come from these files.",
  "type": "object",
  "required": ["domain", "title", "description", "fallback", "terms"],
  "properties": {
    "$schema": { "type": "string" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "used_in": { "type": "array", "items": { "type": "string" } },
    "fallback": { "type": "string", "description": "What a receiver does with a term it does not know." },
    "extension": { "type": "string" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "since"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
          "label": { "type": "string", "maxLength": 40 },
          "description": { "type": "string" },
          "broader": { "type": "string", "description": "A more general term in the same domain, used as the fallback." },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "description": "Other names people use. Never sent on the wire; for search and for mapping a game's own words." },
          "osm": { "type": "string", "description": "The closest OpenStreetMap tag, for place kinds." },
          "status": { "enum": ["stable", "proposed", "deprecated"], "default": "stable" },
          "replaced_by": { "type": "string" },
          "since": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    }
  }
}
