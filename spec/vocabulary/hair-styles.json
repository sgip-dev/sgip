{
  "$schema": "../schemas/vocabulary.json",
  "domain": "hair-styles",
  "title": "Hair styles",
  "description": "How a player wears their hair.",
  "used_in": [
    "display.look"
  ],
  "fallback": "A receiver that does not know a hair style uses its broader one; with nothing it knows it uses its own default for the body type.",
  "extension": "x-<platform>.<id>",
  "terms": [
    {
      "id": "short",
      "label": "Short",
      "description": "Short hair.",
      "aliases": [
        "lowcut",
        "low_cut",
        "buzz_cut",
        "crew_cut"
      ],
      "since": "0.1"
    },
    {
      "id": "pixie",
      "label": "Pixie cut",
      "description": "A very short cut, close at the back and sides.",
      "broader": "short",
      "since": "0.1"
    },
    {
      "id": "bald",
      "label": "Bald",
      "description": "No hair, or shaved.",
      "aliases": [
        "shaved"
      ],
      "since": "0.1"
    },
    {
      "id": "afro",
      "label": "Afro",
      "description": "Natural hair worn out and full.",
      "since": "0.1"
    },
    {
      "id": "curly",
      "label": "Curly",
      "description": "Loose curls.",
      "since": "0.1"
    },
    {
      "id": "braids",
      "label": "Braids",
      "description": "Braided hair, including box braids and cornrows.",
      "aliases": [
        "box_braids",
        "cornrows"
      ],
      "since": "0.1"
    },
    {
      "id": "locs",
      "label": "Locs",
      "description": "Locked hair.",
      "aliases": [
        "dreadlocks",
        "dreads"
      ],
      "since": "0.1"
    },
    {
      "id": "long",
      "label": "Long",
      "description": "Long hair worn down.",
      "since": "0.1"
    },
    {
      "id": "straight",
      "label": "Straight",
      "description": "Long straight hair.",
      "broader": "long",
      "aliases": [
        "bone_straight",
        "bonestraight"
      ],
      "since": "0.1"
    },
    {
      "id": "bob",
      "label": "Bob",
      "description": "A jaw-length cut.",
      "since": "0.1"
    },
    {
      "id": "fringe",
      "label": "Fringe",
      "description": "Hair cut across the forehead.",
      "aliases": [
        "bangs"
      ],
      "since": "0.1"
    },
    {
      "id": "bun",
      "label": "Bun",
      "description": "Hair gathered into a bun.",
      "since": "0.1"
    },
    {
      "id": "ponytail",
      "label": "Ponytail",
      "description": "Hair tied back into a tail.",
      "since": "0.1"
    }
  ]
